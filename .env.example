# Copy this file to .env next to the compose file. The compose files forward every
# variable in here to the application container (see the environment-variables docs page).
# DB_HOST and DB_PORT are wired by the compose file itself.
DB_USER=dbuser
DB_PASSWORD=CHANGEME_GENERATE_STRONG_PASSWORD
DB_NAME=boardgametracker
DB_PORT=5432

TZ=UTC

AUTH_ENABLED=true
# Required while AUTH_ENABLED=true: at least 32 random characters, e.g. the output of `openssl rand -base64 48`.
# The application refuses to start while it is empty or still starts with CHANGEME.
JWT_SECRET=

# Initial password for the seeded 'admin' account (at least 8 characters). Defaults to 'admin' when empty.
ADMIN_PASSWORD=

# Strongly recommended, at least 32 characters and different from JWT_SECRET, e.g. the output of `openssl rand -base64 48`.
# Encrypts the data protection keys stored in the database, which protect the OIDC client secret,
# the BGG and changedetection.io API keys and password-reset links. Without it a database dump is
# enough to read those secrets and a warning is logged at startup. Existing keys are encrypted at
# the next start. Keep it safe and stable: changing or removing it makes the stored secrets
# unreadable (enter them again) and invalidates open reset links.
DATA_PROTECTION_KEY=

TRUSTED_PROXIES=
CORS_ORIGINS=
SWAGGER_ENABLED=false

RAG_ENABLED=false
# Chat provider: "ollama" for a local model, or "openai" for any OpenAI-compatible
# endpoint (OpenAI, or Anthropic/Claude via https://api.anthropic.com/v1).
AI_PROVIDER=ollama
AI_BASE_URL=http://ollama:11434
AI_CHAT_MODEL=qwen3:4b
AI_API_KEY=
# Embeddings always run on local Ollama (bge-m3, 1024-dim, pinned to the DB schema).
AI_EMBEDDING_BASE_URL=http://ollama:11434
# Embedding GPU layers: -1 lets Ollama decide (use the GPU when free). Set to 0 to pin
# the embedder to CPU so a local chat model keeps the GPU to itself on a small card.
AI_EMBEDDING_NUM_GPU=-1

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=true
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=BoardGameTracker

# Host folders used by docker-compose.build.yml
IMAGE_PATH=./images
LOG_PATH=./logs
DB_PATH=./postgres-data
MANUALS_PATH=./manuals
OLLAMA_PATH=./ollama
