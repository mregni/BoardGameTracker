{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Renovate config for BoardGameTracker",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    "group:allNonMajor",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "Europe/Brussels",
  "schedule": [
    "before 6am on Monday"
  ],
  "updateNotScheduled": false,
  "labels": [
    "dependencies"
  ],
  "rebaseWhen": "conflicted",
  "vulnerabilityAlerts": {
    "labels": [
      "security",
      "dependencies"
    ],
    "schedule": [
      "at any time"
    ],
    "automerge": false
  },
  "packageRules": [
    {
      "groupName": "TanStack packages",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchPackageNames": [
        "/^@tanstack//"
      ]
    },
    {
      "groupName": "Radix UI packages",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchPackageNames": [
        "/^@radix-ui//"
      ]
    },
    {
      "groupName": "Nivo chart packages",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchPackageNames": [
        "/^@nivo//"
      ]
    },
    {
      "matchPackageNames": [
        "@biomejs/biome"
      ],
      "groupName": "Biome"
    },
    {
      "groupName": "Vite",
      "matchPackageNames": [
        "/^vite/",
        "/^@vitejs//"
      ]
    },
    {
      "groupName": "i18next packages",
      "matchPackageNames": [
        "/^i18next/",
        "/^react-i18next/"
      ]
    },
    {
      "groupName": "Frontend test packages",
      "matchPackageNames": [
        "/^vitest/",
        "/^@testing-library//",
        "/^@vitest//"
      ]
    },
    {
      "groupName": "EF Core packages",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchPackageNames": [
        "/^Microsoft.EntityFrameworkCore/"
      ]
    },
    {
      "groupName": "ASP.NET Core Identity",
      "matchPackageNames": [
        "/^Microsoft.AspNetCore.Identity/"
      ]
    },
    {
      "groupName": "Backend test packages",
      "matchPackageNames": [
        "/^xunit/",
        "/^Moq/",
        "/^FluentAssertions/"
      ]
    },
    {
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "matchDepTypes": [
        "devDependencies"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "labels": [
        "dependencies",
        "major-update"
      ]
    },
    {
      "automerge": false,
      "labels": [
        "dependencies",
        "security-sensitive"
      ],
      "matchPackageNames": [
        "/^Microsoft.AspNetCore.Authentication/",
        "/^System.IdentityModel/",
        "/^Microsoft.IdentityModel/"
      ]
    },
    {
      "description": "A PostgreSQL major is a data migration, not a dependency bump",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "pgvector/pgvector"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "xunit.v3 4 moves to Microsoft.Testing.Platform (new dotnet test, coverage and Sonar wiring); TanStack Table 9 is an API rewrite",
      "matchPackageNames": [
        "xunit.v3",
        "xunit.runner.visualstudio",
        "@tanstack/react-table"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    }
  ],
  "dockerfile": {
    "pinDigests": true
  },
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "Dependency Dashboard",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "docker-compose": {
    "pinDigests": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on monday"
    ]
  }
}
